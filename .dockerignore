.git
**/__pycache__
**/.venv
backend/htmlcov
frontend/blob-report
frontend/dist
frontend/node_modules
# A local `bun run build` writes here, and `COPY ./backend/app` would bake
# that developer's chunks into the image underneath the one built above -
# which is why production was serving four entry chunks from four builds.
backend/app/frontend
frontend/playwright-report
frontend/test-results
node_modules

# Never bake configuration or secrets into the image: the app reads these at
# runtime from env vars or a mounted file, so a copy here would ship credentials.
.env
.env.*
*.env
models.toml
