# TLS terminator for the deployed instance.
#
# Caddy obtains and renews Let's Encrypt certificates automatically using the
# HTTP-01 challenge, so port 80 must stay reachable from the internet.

{
	email {$ACME_EMAIL}

	# This origin sits behind Cloudflare, which may connect over plain HTTP (its
	# "Flexible" SSL mode). Redirecting HTTP to HTTPS here would send that request
	# straight back to Cloudflare and loop forever, so both schemes serve the app.
	# With Cloudflare set to Full (strict) this line can be removed.
	auto_https disable_redirects
}

# One definition, used by every address below.
(app) {
	encode zstd gzip

	request_body {
		max_size 64MB
	}

	# The MCP server is a separate container. It mounts at /mcp, so the path is
	# passed through unchanged. This must come before the catch-all, which would
	# otherwise hand /mcp to the single-page app.
	handle /mcp* {
		reverse_proxy mcp:8000 {
			# MCP streams its responses; buffering would stall every tool call.
			flush_interval -1
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	# Security headers. Set here rather than in the app because they belong to
	# every response the origin makes, including the ones the app never sees.
	header {
		# The site is HTTPS-only in practice; no preload, because that is a
		# one-way door and belongs to whoever owns the domain.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Framing this application is never useful and is how clickjacking works.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		# Nothing here needs a camera, a microphone or a location.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# Asset caching is set by the application, not here, because it depends on
	# the response status and this directive cannot see one. Setting
	# `immutable` on every /assets/* answer cached the 404s and 502s too - for a
	# year, unrevalidatable, and across builds, since chunk filenames are content
	# hashes and mostly do not change. See AssetCacheHeaders in backend/app/main.py.

	# The shell is the opposite: it names this deploy's asset hashes, so a cached
	# copy after a deploy points at files that no longer exist.
	#
	# Matched by exclusion, not by listing paths. The application is a single
	# page: the same shell is served for /search, /ask, /usage and every other
	# client route, and naming only "/" left all of them with no Cache-Control
	# at all - which means heuristic caching, which means a browser holding a
	# shell that points at chunks the next deploy deletes. That is exactly the
	# "Failed to fetch dynamically imported module" people were seeing.
	@shell not path /assets/* /api/*
	header @shell Cache-Control "no-cache"

	# An error Caddy makes itself - an upstream it could not reach - never
	# reaches the application, so the application cannot say how to cache it.
	# It says so here instead. A 502 is not cacheable by default, but "not by
	# default" is a weaker guarantee than saying it, and this is the failure
	# whose caching broke /search for a week.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	handle {
		reverse_proxy backend:8000 {
			# Answers stream as server-sent events; buffering would hold them back.
			flush_interval -1
			# Cloudflare puts the visitor's address here; pass on something truthful.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}

			# A deploy recreates this container, so for a few seconds there is no
			# upstream at all. Wait for it to come back rather than answering 502:
			# a deploy should be slow for a moment, not broken for a moment.
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
}

# HTTPS, with the Let's Encrypt certificate.
{$SITE_DOMAINS} {
	import app
}

# Plain HTTP for the same names. Disabling redirects above leaves port 80
# without a handler, and that is the port Cloudflare actually connects to.
{$SITE_DOMAINS_HTTP} {
	import app
}

# Reaching the box by its IP keeps working, which is useful when DNS or the CDN
# is the thing being debugged.
http://{$SERVER_IP} {
	import app
}
