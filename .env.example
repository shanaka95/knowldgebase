# Copy to .env and fill in. Never commit the result.
#
#   cp .env.example .env
#   cp models.example.toml models.toml
#
# Generate the secrets with:  openssl rand -base64 36

FASTAPI_ENV=development
PROJECT_NAME="PlusGPT"

SECRET_KEY=change-me
FIRST_SUPERUSER=you@example.com
FIRST_SUPERUSER_PASSWORD=change-me-too

# CORS origin of the Vite dev server; not needed when the app is served
# same-origin from the backend image.
FRONTEND_HOST=http://localhost:5173

# Postgres. Compose overrides the host with the in-network name.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_documents

# Object storage for attachments and imported files
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kbminio
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=kb-attachments
MINIO_SECURE=false
MAX_UPLOAD_SIZE_MB=25
MAX_IMPORT_SIZE_MB=50

# AI models live in models.toml. Any value there can be overridden here, e.g.
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=

# Hybrid retrieval
RRF_K=60
RETRIEVAL_CANDIDATES_PER_SOURCE=50
# Cosine floor for semantic hits; 0 keeps every match. See docs/RETRIEVAL.md.
VECTOR_MIN_SCORE=0.15

# Background worker
WORKER_CONCURRENCY=2
IMPORT_CONCURRENCY=1
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=5
WORKER_OFFLINE_AFTER_SECONDS=30
EMBEDDING_DEBOUNCE_SECONDS=10
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BACKOFF_SECONDS=30

# --- Model context budgets ----------------------------------------------------
# Both are properties of the models you deployed, not of the app.
# Characters, because that is what providers enforce; roughly 4 characters per
# token for English, closer to 3.75 for dense German.
# qwen3-embedding-8b holds 32k tokens; the local Jina model holds far less.
EMBEDDING_MAX_CHARS=24000
# A big chat context lets a long page be summarised in one pass instead of
# window by window. qwen3.8-flash holds 1M tokens.
LLM_WINDOW_CHARS=20000
LLM_MAX_OUTPUT_TOKENS=8192

# --- Reranker (optional) ------------------------------------------------------
# A cross-encoder reads the query against each retrieved page and reorders them,
# which fusion cannot do. It also decides which pages the answering model reads.
# Leave RERANK_MODEL empty to turn it off; search then keeps its fused order.
RERANK_MODEL=
RERANK_BASE_URL=
RERANK_API_KEY=

# --- Email (AWS SES) ----------------------------------------------------------
# Registration, sign-in codes and password resets all go through this. Leave it
# false in development: nothing is sent and the codes are written to the log,
# so every flow still works offline.
EMAIL_ENABLED=false
EMAIL_FROM=noreply@plusgpt.io
EMAIL_FROM_NAME=PlusGPT
AWS_REGION=eu-west-1
# Set these from the host environment; they must never be baked into an image.
AWS_ACCESS_KEY=
AWS_ACCESS_SECRET=

# Where the links inside those emails point. On a deployment this is the public
# address, or nobody can click them.
# FRONTEND_HOST=https://plusgpt.io
